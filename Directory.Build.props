<Project>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <OtherFlags>$(OtherFlags) --reflectionfree --warnon:1182</OtherFlags>
    <Nullable>enable</Nullable>
    <NoWarn>FS0104</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- FS3511: https://github.com/dotnet/fsharp/issues/12038 -->
    <!-- NU1900=info, NU1901=low, NU1902=moderate: suppressed as warnings only -->
    <!-- NU1903=high, NU1904=critical: intentionally left as errors to block builds -->
    <WarningsNotAsErrors>FS3511, NU1900, NU1901, NU1902</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1900;NU1901;NU1902</NoWarn>
  </PropertyGroup>
</Project>

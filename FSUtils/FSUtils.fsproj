<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <WarnOn>FS3389; FS3395</WarnOn>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.2.0</Version>
    <PackageId>Summatic.FSUtils</PackageId>
    <Description>General-purpose F# utilities: an ImmutableArray module, an immutable 2D array, IEquatable/IComparable helpers, Result and ValueOption combinators, and a UTC instant type.</Description>
    <PackageTags>fsharp;immutablearray;immutable;collections</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SummaticLtd/FSharpUtils</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SummaticLtd/FSharpUtils</PackageProjectUrl>
    <!-- Pin the floor rather than inheriting the SDK's FSharp.Core, which would force every consumer up to it. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.300" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Core.fs" />
    <Compile Include="Dictionary.fs" />
    <Compile Include="ImmutableDictionary.fs" />
    <Compile Include="Seq.fs" />
    <Compile Include="Array.fs" />
    <Compile Include="ImmArray.fs" />
    <Compile Include="Combinators.fs" />
    <Compile Include="Parse.fs" />
    <Compile Include="Measure.fs" />
    <Compile Include="Compare.fs" />
    <Compile Include="Instant.fs" />
    <Compile Include="ImmA2D.fs" />
    <Compile Include="Equality.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Lazy.fs" />
    <Compile Include="Builders.fs" />
  </ItemGroup>

</Project>
